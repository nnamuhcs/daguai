{
  "name": "daguai-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "start:model": "AI_MODEL=training/checkpoints/latest.pt node server.js",
    "start:foundation": "AI_WORKER=foundation AI_MODEL=training/foundation/checkpoints/latest.pt node server.js",
    "start:team-ppo": "AI_WORKER=foundation AI_MODEL=training/ppo/checkpoints/latest.pt node server.js",
    "start:strategic": "HOST=127.0.0.1 AI_WORKER=strategic AI_MODEL=training/ppo/checkpoints/strategic/latest.pt node server.js",
    "test": "node --test",
    "test:browser": "node browser-check.js",
    "benchmark": "node benchmark.js",
    "soak": "node soak.js",
    "train": ".venv/bin/python training/train.py",
    "evaluate": ".venv/bin/python training/evaluate.py",
    "train:foundation": ".venv/bin/python training/foundation.py train",
    "train:team-ppo": ".venv/bin/python training/team_ppo.py train",
    "evaluate:foundation": ".venv/bin/python training/foundation.py evaluate",
    "monitor:foundation": ".venv/bin/python training/foundation.py monitor",
    "test:rl": ".venv/bin/python -m unittest discover -s training -p 'test*.py'",
    "test:model": "node model-check.js",
    "test:foundation-model": "AI_WORKER=foundation AI_MODEL=training/foundation/checkpoints/latest.pt node model-check.js",
    "audit:rules": "node --test engine.test.js policy.test.js foundation.test.js",
    "audit:traces": ".venv/bin/python training/trace_audit.py",
    "audit:privacy": "node training/privacy-audit.js",
    "audit:ppo": "PYTHONPATH=training .venv/bin/python -m unittest test_team_ppo test_contracts",
    "audit:actions": ".venv/bin/python training/action_audit.py",
    "audit:warm-start": ".venv/bin/python training/warm_start_audit.py",
    "prepare:team-ppo": ".venv/bin/python training/distill_start.py",
    "pilot:team-ppo": ".venv/bin/python training/retained_pilot.py",
    "monitor:team-ppo": ".venv/bin/python training/progress_dashboard.py",
    "extend:team-ppo": ".venv/bin/python training/extend_ppo.py",
    "ablate:strategic": ".venv/bin/python training/strategic_ablation.py",
    "eval:tournament": ".venv/bin/python training/tournament.py",
    "eval:continued-rounds": ".venv/bin/python training/tournament.py --rounds continued",
    "eval:sampling": ".venv/bin/python training/sampling_sweep.py",
    "eval:tactical": ".venv/bin/python training/tactical_audit.py",
    "eval:release": ".venv/bin/python training/check_release.py",
    "learn:continuous": ".venv/bin/python training/continuous_learn.py",
    "learn:status": ".venv/bin/python training/learner_status.py",
    "start:champion": "node start-champion.js",
    "learn:evidence": ".venv/bin/python training/learning_evidence.py",
    "learn:decisions": ".venv/bin/python training/decision_quality.py"
  },
  "devDependencies": {
    "playwright": "^1.58.0"
  }
}
